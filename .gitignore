# Create .gitignore file
@"
# Virtual Environment
venv/
env/
ENV/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/

# Django
*.log
db.sqlite3
*.sqlite3
media/
staticfiles/

# Environment variables
.env
*.env

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Celery
celerybeat-schedule*

# Sensitive files
assistant_api_key.txt
"@ | Out-File -FilePath ".gitignore" -Encoding UTF8